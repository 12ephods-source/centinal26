{
  "version": "1.0",
  "policy": "maximum-useful-authority-protected-recovery-root",
  "default_agent_mode": "REPOSITORY_ADMIN_CAPABLE",
  "roles": {
    "planner": {"mutating": true, "purpose": "plan and dispatch bounded work"},
    "builder": {"mutating": true, "purpose": "implement authorized repository work"},
    "judge": {"mutating": false, "capable_of_mutation": true, "purpose": "independent verification; mutation disabled by default"},
    "sre": {"mutating": true, "purpose": "repair attributable operational failures"},
    "sentinel": {"mutating": false, "capable_of_mutation": true, "purpose": "independent evidence and audit"},
    "release": {"mutating": true, "purpose": "promote only independently verified artifacts"}
  },
  "root_deny": [
    "account_or_org_ownership_transfer",
    "authentication_or_recovery_factor_change",
    "independent_audit_destruction_or_disablement",
    "independent_backup_destruction",
    "unrestricted_credential_issuance",
    "billing_or_payment_authority",
    "self_modification_of_root_authority_policy"
  ],
  "required_controls": [
    "guardian_authorization",
    "bounded_execution",
    "queue_lease",
    "postcondition_verification",
    "independent_judge_for_consequential_mutations",
    "sentinel_evidence",
    "rollback_or_prior_good_reference",
    "circuit_breaker",
    "quarantine_on_repeated_failure"
  ]
}
