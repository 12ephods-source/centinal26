{
  "schema": "FTOE-LLM-PROVIDER-REGISTRY-v2",
  "policy": {
    "keys_from_environment_only": true,
    "skip_unconfigured_providers": true,
    "no_key_logging": true,
    "no_provider_can_publish_or_merge": true,
    "all_claims_require_local_gate_evidence": true,
    "model_discovery_when_supported": true,
    "preserve_disagreement": true,
    "max_calls_per_cycle_env": "FTOE_MAX_LLM_CALLS_PER_CYCLE"
  },
  "providers": {
    "openai": {"api_key_env":"OPENAI_API_KEY","model_env":"OPENAI_MODEL","default_model":"gpt-5","preferred_models":["gpt-5","gpt-5.1","gpt-5-pro"],"mode":"responses","priority":10},
    "anthropic": {"api_key_env":"ANTHROPIC_API_KEY","model_env":"ANTHROPIC_MODEL","default_model":"claude-sonnet-4-5","preferred_models":["claude-opus-4-1","claude-sonnet-4-5"],"mode":"messages","priority":20},
    "gemini": {"api_key_env":"GEMINI_API_KEY","model_env":"GEMINI_MODEL","default_model":"gemini-3.6-flash","preferred_models":["gemini-3.6-flash","gemini-3.5-flash","gemini-3.1-pro"],"mode":"generateContent","priority":30},
    "deepseek": {"api_key_env":"DEEPSEEK_API_KEY","model_env":"DEEPSEEK_MODEL","default_model":"deepseek-v4-pro","preferred_models":["deepseek-v4-pro","deepseek-v4-flash"],"mode":"openai-chat","priority":40},
    "xai": {"api_key_env":"XAI_API_KEY","model_env":"XAI_MODEL","default_model":"grok-4.5","preferred_models":["grok-4.5","latest"],"mode":"openai-chat","priority":50},
    "mistral": {"api_key_env":"MISTRAL_API_KEY","model_env":"MISTRAL_MODEL","default_model":"mistral-large-latest","preferred_models":["mistral-large-latest"],"mode":"openai-chat","priority":60},
    "cohere": {"api_key_env":"COHERE_API_KEY","model_env":"COHERE_MODEL","default_model":"command-a","preferred_models":["command-a"],"mode":"cohere-chat","priority":70}
  },
  "roles": ["theorist","group_theory_auditor","phenomenology_auditor","numerical_verifier","adversarial_referee","literature_synthesizer","manuscript_editor"],
  "publication_rule": "Models may propose, criticize, cross-check, and draft. Disagreement is preserved and escalated. Only deterministic local gates plus explicit publication-readiness checks can mark a result publishable."
}
