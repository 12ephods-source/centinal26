      "rationale": "Canonical Automation history already provides immutable content-addressed artifact staging and hashing."
    },
    {
      "rank": 11,
      "capability": "encrypted_off_device_backup_rotation",
      "classification": "NEW_REQUIRED",
      "canonical_owner": "AICCEP-OS continuity layer",
      "action": "BUILD_AFTER_INTEGRATION",
      "rationale": "AICCEP and Second Brain have backup primitives, but encrypted off-device disaster-recovery policy is not established as canonical."
    },
    {
      "rank": 12,
      "capability": "signed_portable_export_import_bundle",
      "classification": "PARTIAL",
      "canonical_owner": "AICCEP-OS continuity layer",
      "action": "EXTEND_EXISTING_EXPORTS",
      "rationale": "Exports, manifests, checksums, and audit anchors exist in prior lines; a single signed portable interchange contract remains to be unified."
    },
    {
      "rank": 13,
      "capability": "optimistic_multiwriter_concurrency",
      "classification": "NEW_REQUIRED",
      "canonical_owner": "AICCEP-OS continuity layer",
      "action": "BUILD_AFTER_INTEGRATION",
      "rationale": "Execution leases exist elsewhere, but knowledge-record revision conflict handling is not established as a canonical multiwriter contract."
    },
    {
      "rank": 14,
      "capability": "polymorphic_relation_integrity",
      "classification": "PARTIAL",
      "canonical_owner": "AICCEP-OS continuity layer",
      "action": "HARDEN",
      "rationale": "AICCEP already has typed relationships; Second Brain adds stronger lifecycle and reference constraints that should be integrated rather than duplicated."
    },
    {
      "rank": 15,
      "capability": "versioned_json_schema_governance",
      "classification": "PARTIAL",
      "canonical_owner": "Centinal26 governance",
      "action": "EXTEND",
      "rationale": "Centinal26 already contains deterministic governance and schema contracts; knowledge-domain schemas should join that governance surface."
    },
    {
      "rank": 16,
      "capability": "hardened_manifest_semantics",
      "classification": "PARTIAL",
      "canonical_owner": "Frost CORE",
      "action": "HARDEN",
      "rationale": "Hashing and immutable manifests exist, but a single explicit policy for symlinks, hardlinks, exclusions, permissions, sparse files, and recursion is still useful."
    },
    {
      "rank": 17,
      "capability": "orphan_reconciliation_and_garbage_collection",
      "classification": "NEW_REQUIRED",
      "canonical_owner": "AICCEP-OS continuity layer",
      "action": "BUILD_AFTER_INTEGRATION",
      "rationale": "Knowledge-state reconciliation needs a non-destructive orphan detector before any garbage collection can be authorized."
    },
    {
      "rank": 18,
      "capability": "single_source_schema_generation",
      "classification": "NEW_REQUIRED",
      "canonical_owner": "Centinal26 governance",
      "action": "BUILD_AFTER_INTEGRATION",
      "rationale": "Schema SQL, migrations, JSON contracts, installer payloads, and documentation should derive from one governed source instead of drifting independently."
    }
  ],
