    "knowledge_task": {"metadata_owner": "AICCEP-OS"},
    "execution_task": {"metadata_owner": "Centinal26/Frost CORE"},
    "ai_session": {"metadata_owner": "AICCEP-OS", "byte_owner": "Frost CORE for immutable transcript/tool artifacts"},
