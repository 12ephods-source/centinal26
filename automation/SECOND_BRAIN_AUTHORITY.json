  "adapter_contract": {
    "direction": "second_brain_v0_2_to_canonical_proposal",
    "write_mode": "proposal_only",
    "required_properties": [
      "schema_validation",
      "stable_identity_mapping",
      "source_record_hash",
      "epistemic_status_preservation",
      "relationship_preservation",
      "artifact_hash_verification",
