{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frost.local/schemas/scientific_autocycle_v1.schema.json",
  "title": "Frost Scientific Autocycle v1 metadata",
  "type": "object",
  "additionalProperties": true,
  "required": ["goal", "success"],
  "properties": {
    "goal": {"type": "string", "minLength": 1},
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": {"type": "integer"},
        "required_text": {"type": "array", "items": {"type": "string"}},
        "forbidden_text": {"type": "array", "items": {"type": "string"}}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {"type": "integer", "minimum": 1, "maximum": 100},
        "episode_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "perspectives": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["engineering", "empirical", "causal", "falsification", "information_value", "discovery", "resource", "epistemic"]
      }
    },
    "agent_providers": {"type": "array", "items": {"type": "string"}},
    "origin": {"type": "object"},
    "capabilities": {"type": "object"},
    "notes": {"type": "string"}
  }
}
