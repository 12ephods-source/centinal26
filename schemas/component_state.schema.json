{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centinal26.local/schemas/component_state.schema.json",
  "title": "Centinal26 Component Control State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "component",
    "verification_debt",
    "deployment_debt",
    "failure_streak",
    "circuit_state",
    "opened_at",
    "last_revalidated_at",
    "drift_status"
  ],
  "properties": {
    "schema": {"const": "centinal26-component-state-v1"},
    "component": {"type": "string", "minLength": 1},
    "verification_debt": {"type": "integer", "minimum": 0},
    "deployment_debt": {"type": "integer", "minimum": 0},
    "failure_streak": {"type": "integer", "minimum": 0},
    "circuit_state": {"enum": ["CLOSED", "OPEN", "HALF_OPEN"]},
    "opened_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "last_revalidated_at": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "drift_status": {"enum": ["UNKNOWN", "CLEAN", "DRIFTED", "REVALIDATE"]}
  }
}
