{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centinal26.local/schemas/operation.schema.json",
  "title": "Centinal26 Governed Operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation_id", "actor", "authorization_id", "capability_id", "scope", "risk_class", "preconditions", "postconditions", "destructive", "preservation_evidence_refs"],
  "properties": {
    "schema": {"const": "centinal26-operation-v1"},
    "operation_id": {"type": "string", "minLength": 1},
    "actor": {"type": "string", "minLength": 1},
    "authorization_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "scope": {"type": "object"},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "preconditions": {"type": "array"},
    "postconditions": {"type": "array", "minItems": 1},
    "destructive": {"type": "boolean"},
    "preservation_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
