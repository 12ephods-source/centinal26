{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centinal26.local/schemas/mutation_contract.schema.json",
  "title": "Centinal26 Mutation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_id",
    "authority",
    "actor_identity",
    "target_identity",
    "preconditions",
    "blast_radius",
    "rollback_plan",
    "postconditions",
    "idempotency_key",
    "evidence_required",
    "canary_supported",
    "consequential"
  ],
  "properties": {
    "schema": {"const": "centinal26-mutation-contract-v1"},
    "operation_id": {"type": "string", "minLength": 1},
    "authority": {"type": "string", "minLength": 1},
    "actor_identity": {"type": "string", "minLength": 1},
    "target_identity": {"type": "string", "minLength": 1},
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "blast_radius": {"type": "integer", "minimum": 0, "maximum": 3},
    "rollback_plan": {"type": "string", "minLength": 1},
    "postconditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "idempotency_key": {"type": "string", "minLength": 1},
    "evidence_required": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "canary_supported": {"type": "boolean"},
    "consequential": {"type": "boolean"}
  }
}
