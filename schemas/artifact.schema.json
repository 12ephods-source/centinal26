{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automation.local/schemas/artifact.schema.json",
  "title": "Automation Artifact Registry Entry",
  "type": "object",
  "required": ["artifact_id", "name", "classification", "source", "content_imported", "validation"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "classification": {
      "enum": ["CANONICAL", "COMPATIBLE_MODULE", "EXPERIMENTAL", "SUPERSEDED", "REJECTED"]
    },
    "source": {
      "type": "object",
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"enum": ["file_library", "repository", "generated"]},
        "ref": {"type": "string", "minLength": 1},
        "created_at": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "content_imported": {"type": "boolean"},
    "repository_path": {"type": ["string", "null"]},
    "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "validation": {
      "type": "object",
      "required": ["state", "physical_device_validated"],
      "properties": {
        "state": {"enum": ["UNVERIFIED", "STATIC_VALIDATED", "HOST_VALIDATED", "REVIEW", "PASS", "FAIL"]},
        "physical_device_validated": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
