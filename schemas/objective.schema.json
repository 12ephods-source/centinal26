{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://centinal26.local/schemas/objective.schema.json",
  "title": "Centinal26 Objective Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "objective_id",
    "text",
    "source",
    "source_ref",
    "root_objective",
    "requested_capabilities"
  ],
  "properties": {
    "schema": {"const": "centinal26-objective-proposal-v1"},
    "objective_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "text": {"type": "string", "minLength": 1},
    "source": {
      "enum": [
        "OWNER",
        "OWNER_POLICY",
        "LOCAL_AGENT",
        "REMOTE_AGENT",
        "TOOL",
        "IMPORTED_DOCUMENT",
        "WEB",
        "UNKNOWN"
      ]
    },
    "source_ref": {"type": "string", "minLength": 1},
    "root_objective": {"type": "string", "minLength": 1, "maxLength": 128},
    "parent_objective_id": {"type": ["string", "null"]},
    "requested_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authorization_ref": {"type": ["string", "null"]}
  }
}
